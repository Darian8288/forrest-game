<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1"/>
  <title>Forest Survival (Mini)</title>
  <style>
    :root{
      --bg:#0b1220; --panel:#121b2e; --panel2:#0f1729;
      --text:#e6edf7; --muted:#9fb0cc;
      --good:#4ade80; --warn:#fbbf24; --bad:#fb7185;
      --tile:#0e2a1b; --grid:#153a27;
      --tree:#2f7d3b; --rock:#5b6474; --bush:#3aa56b;
      --player:#60a5fa; --wolf:#f97316; --fire:#fbbf24;
      --outline:rgba(255,255,255,0.08);
    }
    *{ box-sizing:border-box; }
    body{
      margin:0; background:linear-gradient(180deg, #070b14, var(--bg));
      color:var(--text); font-family: ui-sans-serif, system-ui, -apple-system, Segoe UI, Roboto, Helvetica, Arial;
      height:100vh; display:grid; place-items:center;
    }
    .wrap{
      width:min(1100px, 96vw);
      display:grid;
      grid-template-columns: 1fr 320px;
      gap:14px;
      padding:14px;
    }
    .game{
      background:rgba(255,255,255,0.02);
      border:1px solid var(--outline);
      border-radius:18px;
      overflow:hidden;
      box-shadow: 0 20px 60px rgba(0,0,0,0.45);
    }
    canvas{
      display:block;
      width:100%;
      height:100%;
      background:
        radial-gradient(800px 400px at 50% 0%, rgba(46, 160, 67, 0.12), transparent 60%),
        linear-gradient(180deg, rgba(255,255,255,0.02), transparent);
    }
    .side{
      background:rgba(255,255,255,0.02);
      border:1px solid var(--outline);
      border-radius:18px;
      padding:14px;
      display:flex;
      flex-direction:column;
      gap:12px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.35);
    }
    .title{
      display:flex; align-items:baseline; justify-content:space-between;
      gap:10px;
    }
    .title h1{ font-size:16px; margin:0; letter-spacing:0.3px; }
    .badge{ font-size:12px; color:var(--muted); }

    .bar{
      height:10px; background:rgba(255,255,255,0.06);
      border-radius:999px; overflow:hidden;
      border:1px solid rgba(255,255,255,0.06);
    }
    .fill{ height:100%; width:50%; border-radius:999px; }
    .row{ display:flex; align-items:center; justify-content:space-between; gap:10px; }
    .row small{ color:var(--muted); }
    .kpi{ font-size:12px; color:var(--muted); }
    .inv{
      background:rgba(0,0,0,0.18);
      border:1px solid rgba(255,255,255,0.06);
      border-radius:14px;
      padding:10px;
    }
    .inv h2{ font-size:13px; margin:0 0 8px 0; color:var(--muted); }
    .grid{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:8px;
      font-size:12px;
    }
    .pill{
      background:rgba(255,255,255,0.04);
      border:1px solid rgba(255,255,255,0.06);
      border-radius:999px;
      padding:8px 10px;
      display:flex; justify-content:space-between; gap:10px;
    }
    .btns{
      display:grid;
      grid-template-columns: 1fr 1fr;
      gap:8px;
    }
    button{
      cursor:pointer;
      background:rgba(255,255,255,0.06);
      border:1px solid rgba(255,255,255,0.10);
      color:var(--text);
      padding:10px 10px;
      border-radius:12px;
      font-weight:600;
      transition: transform .05s ease, background .2s ease;
      user-select:none;
    }
    button:hover{ background:rgba(255,255,255,0.10); }
    button:active{ transform: translateY(1px); }
    button:disabled{
      opacity:0.45; cursor:not-allowed;
    }

    .log{
      flex:1;
      background:rgba(0,0,0,0.18);
      border:1px solid rgba(255,255,255,0.06);
      border-radius:14px;
      padding:10px;
      overflow:auto;
      font-size:12px;
      color:var(--muted);
      line-height:1.35;
    }
    .log b{ color:var(--text); }
    .hint{
      font-size:12px; color:var(--muted);
      padding:10px;
      border-radius:14px;
      border:1px dashed rgba(255,255,255,0.14);
      background:rgba(255,255,255,0.02);
    }
    .controls{
      display:flex; flex-wrap:wrap; gap:8px;
      margin-top:6px;
    }
    .tag{
      font-size:11px; color:var(--muted);
      padding:6px 8px;
      border-radius:999px;
      background:rgba(255,255,255,0.04);
      border:1px solid rgba(255,255,255,0.06);
    }
  </style>
</head>
<body>
  <div class="wrap">
    <div class="game">
      <canvas id="c" width="760" height="520"></canvas>
    </div>

    <div class="side">
      <div class="title">
        <h1>Forest Survival</h1>
        <div class="badge" id="dayBadge">Day 1</div>
      </div>

      <div>
        <div class="row"><small>HP</small><small id="hpTxt">100 / 100</small></div>
        <div class="bar"><div class="fill" id="hpBar" style="background:var(--good); width:100%"></div></div>
      </div>

      <div>
        <div class="row"><small>Hunger</small><small id="hunTxt">100 / 100</small></div>
        <div class="bar"><div class="fill" id="hunBar" style="background:var(--warn); width:100%"></div></div>
      </div>

      <div>
        <div class="row"><small>XP</small><small id="xpTxt">0 / 30 (Lv 1)</small></div>
        <div class="bar"><div class="fill" id="xpBar" style="background:var(--player); width:0%"></div></div>
      </div>

      <div class="inv">
        <h2>Inventory</h2>
        <div class="grid" id="invGrid"></div>
      </div>

      <div class="btns">
        <button id="gatherBtn">Gather (E)</button>
        <button id="attackBtn">Attack (Space)</button>
        <button id="craftSpearBtn">Craft Spear</button>
        <button id="craftFireBtn">Build Campfire</button>
      </div>

      <div class="hint">
        Survive by gathering, crafting, and fighting wolves.
        <div class="controls">
          <span class="tag">Move: WASD / Arrows</span>
          <span class="tag">Gather: E</span>
          <span class="tag">Attack: Space</span>
          <span class="tag">Restart: R</span>
        </div>
      </div>

      <div class="log" id="log"></div>
    </div>
  </div>

<script>
(() => {
  // ====== Config ======
  const TILE = 26;
  const W = 760, H = 520;
  const COLS = Math.floor(W / TILE);
  const ROWS = Math.floor(H / TILE);

  const TYPES = {
    EMPTY: 0,
    TREE: 1,
    ROCK: 2,
    BUSH: 3,
    FIRE: 4
  };

  const costs = {
    spear: { wood: 6, stone: 2 },
    fire:  { wood: 8, stone: 4 }
  };

  // ====== State ======
  const canvas = document.getElementById("c");
  const ctx = canvas.getContext("2d");

  const ui = {
    hpBar: document.getElementById("hpBar"),
    hunBar: document.getElementById("hunBar"),
    xpBar: document.getElementById("xpBar"),
    hpTxt: document.getElementById("hpTxt"),
    hunTxt: document.getElementById("hunTxt"),
    xpTxt: document.getElementById("xpTxt"),
    invGrid: document.getElementById("invGrid"),
    log: document.getElementById("log"),
    dayBadge: document.getElementById("dayBadge"),
    gatherBtn: document.getElementById("gatherBtn"),
    attackBtn: document.getElementById("attackBtn"),
    craftSpearBtn: document.getElementById("craftSpearBtn"),
    craftFireBtn: document.getElementById("craftFireBtn"),
  };

  let rngSeed = Math.floor(Math.random() * 1e9);
  function mulberry32(a){
    return function() {
      let t = a += 0x6D2B79F5;
      t = Math.imul(t ^ t >>> 15, t | 1);
      t ^= t + Math.imul(t ^ t >>> 7, t | 61);
      return ((t ^ t >>> 14) >>> 0) / 4294967296;
    }
  }
  let rand = mulberry32(rngSeed);

  function clamp(v, a, b){ return Math.max(a, Math.min(b, v)); }
  function dist(ax, ay, bx, by){ return Math.hypot(ax-bx, ay-by); }

  const keys = new Set();

  function log(msg){
    const p = document.createElement("div");
    p.innerHTML = msg;
    ui.log.prepend(p);
  }

  function freshGame(){
    rand = mulberry32(rngSeed);
    dayTick = 0;
    day = 1;

    inv = { wood: 0, stone: 0, berries: 0 };
    player = {
      x: Math.floor(COLS/2),
      y: Math.floor(ROWS/2),
      hp: 100,
      hpMax: 100,
      hunger: 100,
      hungerMax: 100,
      lvl: 1,
      xp: 0,
      xpNeed: 30,
      hasSpear: false,
      atk: 8,
      atkSpear: 16,
      range: 1.25,
      healCooldown: 0
    };

    wolves = [];
    map = makeMap();
    spawnWolves(2);
    log(`<b>New run</b> — seed ${rngSeed}. Gather resources and survive.`);
    syncUI();
  }

  // ====== Map Generation ======
  let map = [];
  function makeMap(){
    const m = Array.from({length: ROWS}, () => Array(COLS).fill(TYPES.EMPTY));

    // scatter resources
    for(let y=0; y<ROWS; y++){
      for(let x=0; x<COLS; x++){
        const r = rand();
        if (x===Math.floor(COLS/2) && y===Math.floor(ROWS/2)) continue;
        if (r < 0.10) m[y][x] = TYPES.TREE;
        else if (r < 0.14) m[y][x] = TYPES.ROCK;
        else if (r < 0.18) m[y][x] = TYPES.BUSH;
      }
    }
    // carve a little clearing near spawn
    for(let dy=-2; dy<=2; dy++){
      for(let dx=-2; dx<=2; dx++){
        const xx = clamp(player.x+dx,0,COLS-1);
        const yy = clamp(player.y+dy,0,ROWS-1);
        m[yy][xx] = TYPES.EMPTY;
      }
    }
    return m;
  }

  function tileAt(x,y){
    if (x<0 || y<0 || x>=COLS || y>=ROWS) return null;
    return map[y][x];
  }

  function setTile(x,y,t){
    if (x<0 || y<0 || x>=COLS || y>=ROWS) return;
    map[y][x]=t;
  }

  // ====== Entities ======
  let player;
  let inv;
  let wolves;

  function spawnWolves(n){
    for(let i=0;i<n;i++){
      let x,y;
      let tries=0;
      do{
        x = Math.floor(rand()*COLS);
        y = Math.floor(rand()*ROWS);
        tries++;
      }while(tries<200 && (tileAt(x,y)!==TYPES.EMPTY || dist(x,y,player.x,player.y)<6));
      wolves.push({
        x, y,
        hp: 30 + day*5,
        atk: 10,
        cd: 0
      });
    }
    log(`🐺 <b>${n}</b> wolf(s) appeared in the forest.`);
  }

  // ====== Actions ======
  function gainXP(x){
    player.xp += x;
    while(player.xp >= player.xpNeed){
      player.xp -= player.xpNeed;
      player.lvl += 1;
      player.xpNeed = Math.floor(player.xpNeed * 1.25 + 8);
      player.hpMax += 8;
      player.hp = clamp(player.hp + 12, 0, player.hpMax);
      player.atk += 1;
      log(`✨ Leveled up to <b>Lv ${player.lvl}</b>! Max HP +8, Attack +1.`);
    }
  }

  function nearbyResource(){
    // check current tile + 4-neighbors
    const checks = [
      [player.x, player.y],
      [player.x+1, player.y],
      [player.x-1, player.y],
      [player.x, player.y+1],
      [player.x, player.y-1],
    ];
    for (const [x,y] of checks){
      const t = tileAt(x,y);
      if (t===TYPES.TREE || t===TYPES.ROCK || t===TYPES.BUSH) return {x,y,t};
      if (t===TYPES.FIRE) return {x,y,t};
    }
    return null;
  }

  function gather(){
    const r = nearbyResource();
    if(!r){ log(`Nothing to gather nearby.`); return; }

    if (r.t===TYPES.TREE){
      const got = 2 + (rand()<0.35 ? 1 : 0);
      inv.wood += got;
      setTile(r.x,r.y, TYPES.EMPTY);
      player.hunger = clamp(player.hunger-1, 0, player.hungerMax);
      gainXP(6);
      log(`🪵 Gathered <b>${got}</b> wood.`);
    } else if (r.t===TYPES.ROCK){
      const got = 1 + (rand()<0.35 ? 1 : 0);
      inv.stone += got;
      setTile(r.x,r.y, TYPES.EMPTY);
      player.hunger = clamp(player.hunger-1, 0, player.hungerMax);
      gainXP(7);
      log(`🪨 Mined <b>${got}</b> stone.`);
    } else if (r.t===TYPES.BUSH){
      const got = 2 + (rand()<0.5 ? 1 : 0);
      inv.berries += got;
      setTile(r.x,r.y, TYPES.EMPTY);
      player.hunger = clamp(player.hunger-1, 0, player.hungerMax);
      gainXP(5);
      log(`🫐 Picked <b>${got}</b> berries.`);
    } else if (r.t===TYPES.FIRE){
      // eat berries at campfire
      if(inv.berries<=0){ log(`Campfire is warm... but you have no berries to cook.`); return; }
      const eat = Math.min(inv.berries, 3);
      inv.berries -= eat;
      const heal = eat * 6;
      const hunger = eat * 10;
      player.hp = clamp(player.hp + heal, 0, player.hpMax);
      player.hunger = clamp(player.hunger + hunger, 0, player.hungerMax);
      gainXP(4);
      log(`🔥 Cooked and ate <b>${eat}</b> berries. +${heal} HP, +${hunger} hunger.`);
    }
    syncUI();
  }

  function craftSpear(){
    if (player.hasSpear){ log(`You already have a spear.`); return; }
    if(inv.wood < costs.spear.wood || inv.stone < costs.spear.stone){
      log(`Need <b>${costs.spear.wood}</b> wood + <b>${costs.spear.stone}</b> stone for a spear.`);
      return;
    }
    inv.wood -= costs.spear.wood;
    inv.stone -= costs.spear.stone;
    player.hasSpear = true;
    gainXP(12);
    log(`🗡️ Crafted a <b>Spear</b>! Higher damage.`);
    syncUI();
  }

  function buildFire(){
    const here = tileAt(player.x, player.y);
    if (here !== TYPES.EMPTY){
      log(`You need an empty tile to place a campfire.`);
      return;
    }
    if(inv.wood < costs.fire.wood || inv.stone < costs.fire.stone){
      log(`Need <b>${costs.fire.wood}</b> wood + <b>${costs.fire.stone}</b> stone for a campfire.`);
      return;
    }
    inv.wood -= costs.fire.wood;
    inv.stone -= costs.fire.stone;
    setTile(player.x, player.y, TYPES.FIRE);
    gainXP(15);
    log(`🔥 Built a <b>Campfire</b>. Stand near it and press E to cook berries.`);
    syncUI();
  }

  function attack(){
    // attack nearest wolf in range
    let target = null;
    let bestD = 999;
    for (const w of wolves){
      const d = dist(player.x, player.y, w.x, w.y);
      if (d <= player.range && d < bestD){
        bestD = d; target = w;
      }
    }
    if(!target){
      log(`No enemy in range.`);
      return;
    }
    const dmgBase = player.hasSpear ? player.atkSpear : player.atk;
    const dmg = Math.floor(dmgBase * (0.85 + rand()*0.35));
    target.hp -= dmg;
    player.hunger = clamp(player.hunger-1, 0, player.hungerMax);
    log(`⚔️ You hit a wolf for <b>${dmg}</b> damage.`);
    if(target.hp <= 0){
      wolves = wolves.filter(x => x!==target);
      gainXP(20 + day*2);
      inv.berries += 1 + (rand()<0.4 ? 1:0); // small reward
      log(`🐺 Wolf defeated. You found some food.`);
    }
    syncUI();
  }

  // ====== Game Loop ======
  let last = performance.now();
  let dayTick = 0;
  let day = 1;

  function update(dt){
    // movement
    const speed = 7 * dt; // tiles per second-ish
    let mx = 0, my = 0;
    if(keys.has("ArrowUp") || keys.has("w")) my -= 1;
    if(keys.has("ArrowDown") || keys.has("s")) my += 1;
    if(keys.has("ArrowLeft") || keys.has("a")) mx -= 1;
    if(keys.has("ArrowRight") || keys.has("d")) mx += 1;

    if(mx !== 0 || my !== 0){
      // attempt move to neighbor tile (grid-based)
      const nx = clamp(player.x + Math.sign(mx), 0, COLS-1);
      const ny = clamp(player.y + Math.sign(my), 0, ROWS-1);
      const t = tileAt(nx, ny);
      // block walking into non-empty except FIRE
      if (t === TYPES.EMPTY || t === TYPES.FIRE){
        player.x = nx; player.y = ny;
        player.hunger = clamp(player.hunger - 0.25, 0, player.hungerMax);
      }
    }

    // hunger drain over time
    player.hunger = clamp(player.hunger - 0.22*dt, 0, player.hungerMax);
    if(player.hunger <= 0){
      player.hp = clamp(player.hp - 4.0*dt, 0, player.hpMax);
    }

    // day/night tick (simple)
    dayTick += dt;
    if(dayTick >= 45){ // ~45s per day
      dayTick = 0;
      day += 1;
      ui.dayBadge.textContent = `Day ${day}`;
      spawnWolves(1 + (day%3===0 ? 1 : 0));
      log(`🌙 A new day begins. The forest gets tougher.`);
    }

    // wolves AI
    for (const w of wolves){
      w.cd = Math.max(0, w.cd - dt);

      const d = dist(player.x, player.y, w.x, w.y);
      // chase if close enough
      if(d < 9){
        const dx = player.x - w.x;
        const dy = player.y - w.y;
        const stepX = dx === 0 ? 0 : Math.sign(dx);
        const stepY = dy === 0 ? 0 : Math.sign(dy);

        // choose axis with larger distance (simple)
        const try1 = Math.abs(dx) > Math.abs(dy) ? [w.x+stepX, w.y] : [w.x, w.y+stepY];
        const try2 = Math.abs(dx) > Math.abs(dy) ? [w.x, w.y+stepY] : [w.x+stepX, w.y];

        const canMove = (x,y) => {
          const t = tileAt(x,y);
          return t === TYPES.EMPTY || t === TYPES.FIRE || (x===player.x && y===player.y);
        };

        let moved = false;
        for (const [tx,ty] of [try1, try2]){
          if (tx>=0 && ty>=0 && tx<COLS && ty<ROWS && canMove(tx,ty)){
            // avoid stacking wolves too hard
            if (!wolves.some(o => o!==w && o.x===tx && o.y===ty)){
              w.x = tx; w.y = ty;
              moved = true;
              break;
            }
          }
        }
        if(!moved && rand()<0.12){
          // random shuffle if stuck
          const dirs = [[1,0],[-1,0],[0,1],[0,-1]];
          const [rx,ry] = dirs[Math.floor(rand()*dirs.length)];
          const tx=w.x+rx, ty=w.y+ry;
          if(canMove(tx,ty)) { w.x=tx; w.y=ty; }
        }
      }

      // bite if adjacent
      const d2 = dist(player.x, player.y, w.x, w.y);
      if(d2 <= 1.1 && w.cd<=0){
        w.cd = 1.0; // attack cooldown
        const dmg = Math.floor((10 + day*0.6) * (0.85 + rand()*0.35));
        player.hp = clamp(player.hp - dmg, 0, player.hpMax);
        log(`🐺 Wolf bit you for <b>${dmg}</b> damage.`);
      }
    }

    // auto-heal a tiny bit near campfire
    const nearFire = (() => {
      for (let dy=-1; dy<=1; dy++){
        for(let dx=-1; dx<=1; dx++){
          if(tileAt(player.x+dx, player.y+dy)===TYPES.FIRE) return true;
        }
      }
      return false;
    })();
    if(nearFire && inv.berries>0 && player.hp < player.hpMax && player.healCooldown<=0){
      // small passive regen if you have food
      player.healCooldown = 1.2;
      player.hp = clamp(player.hp + 1, 0, player.hpMax);
    }
    player.healCooldown = Math.max(0, player.healCooldown - dt);

    // lose condition
    if(player.hp <= 0){
      log(`💀 You died on Day <b>${day}</b>. Press <b>R</b> to restart.`);
      keys.clear();
    }

    syncUI();
  }

  function syncUI(){
    // bars
    const hpPct = (player.hp / player.hpMax) * 100;
    const hunPct = (player.hunger / player.hungerMax) * 100;
    const xpPct = (player.xp / player.xpNeed) * 100;

    ui.hpBar.style.width = `${hpPct}%`;
    ui.hunBar.style.width = `${hunPct}%`;
    ui.xpBar.style.width = `${xpPct}%`;

    ui.hpBar.style.background = hpPct > 55 ? "var(--good)" : (hpPct > 25 ? "var(--warn)" : "var(--bad)");
    ui.hunBar.style.background = hunPct > 55 ? "var(--warn)" : (hunPct > 25 ? "var(--warn)" : "var(--bad)");

    ui.hpTxt.textContent = `${Math.floor(player.hp)} / ${player.hpMax}`;
    ui.hunTxt.textContent = `${Math.floor(player.hunger)} / ${player.hungerMax}`;
    ui.xpTxt.textContent = `${player.xp} / ${player.xpNeed} (Lv ${player.lvl})`;

    // inventory
    ui.invGrid.innerHTML = "";
    const items = [
      ["Wood", inv.wood],
      ["Stone", inv.stone],
      ["Berries", inv.berries],
      ["Weapon", player.hasSpear ? "Spear" : "Fists"],
      ["Wolves", wolves.length],
      ["Seed", rngSeed]
    ];
    for (const [k,v] of items){
      const div = document.createElement("div");
      div.className = "pill";
      div.innerHTML = `<span>${k}</span><span><b>${v}</b></span>`;
      ui.invGrid.appendChild(div);
    }

    // buttons enablement
    ui.craftSpearBtn.disabled = player.hasSpear || inv.wood < costs.spear.wood || inv.stone < costs.spear.stone;
    ui.craftFireBtn.disabled  = tileAt(player.x, player.y) !== TYPES.EMPTY || inv.wood < costs.fire.wood || inv.stone < costs.fire.stone;
    ui.attackBtn.disabled = player.hp <= 0;
    ui.gatherBtn.disabled = player.hp <= 0;
  }

  function draw(){
    ctx.clearRect(0,0,W,H);

    // background grid
    for(let y=0; y<ROWS; y++){
      for(let x=0; x<COLS; x++){
        ctx.fillStyle = "rgba(20,60,40,0.55)";
        ctx.fillRect(x*TILE, y*TILE, TILE, TILE);

        ctx.strokeStyle = "rgba(255,255,255,0.03)";
        ctx.strokeRect(x*TILE, y*TILE, TILE, TILE);
      }
    }

    // tiles
    for(let y=0; y<ROWS; y++){
      for(let x=0; x<COLS; x++){
        const t = map[y][x];
        if (t === TYPES.EMPTY) continue;

        const px = x*TILE + TILE/2;
        const py = y*TILE + TILE/2;

        if(t === TYPES.TREE){
          ctx.fillStyle = "rgba(47,125,59,0.95)";
          ctx.beginPath();
          ctx.arc(px, py, TILE*0.35, 0, Math.PI*2);
          ctx.fill();
          ctx.fillStyle = "rgba(26,70,36,0.9)";
          ctx.fillRect(px-3, py+6, 6, 10);
        } else if(t === TYPES.ROCK){
          ctx.fillStyle = "rgba(91,100,116,0.95)";
          ctx.beginPath();
          ctx.moveTo(px-7, py+7);
          ctx.lineTo(px-10, py-2);
          ctx.lineTo(px-2, py-10);
          ctx.lineTo(px+9, py-4);
          ctx.lineTo(px+7, py+8);
          ctx.closePath();
          ctx.fill();
        } else if(t === TYPES.BUSH){
          ctx.fillStyle = "rgba(58,165,107,0.95)";
          ctx.beginPath();
          ctx.arc(px-6, py+2, TILE*0.22, 0, Math.PI*2);
          ctx.arc(px+2, py-3, TILE*0.24, 0, Math.PI*2);
          ctx.arc(px+8, py+3, TILE*0.20, 0, Math.PI*2);
          ctx.fill();
        } else if(t === TYPES.FIRE){
          // campfire
          ctx.fillStyle = "rgba(120,84,50,0.9)";
          ctx.fillRect(px-10, py+6, 20, 4);
          ctx.fillRect(px-6, py+2, 12, 4);

          ctx.fillStyle = "rgba(251,191,36,0.95)";
          ctx.beginPath();
          ctx.arc(px, py-2, TILE*0.20 + Math.sin(performance.now()/120)*0.8, 0, Math.PI*2);
          ctx.fill();
        }
      }
    }

    // player
    {
      const px = player.x*TILE + TILE/2;
      const py = player.y*TILE + TILE/2;

      ctx.fillStyle = "rgba(96,165,250,0.95)";
      ctx.beginPath();
      ctx.arc(px, py, TILE*0.28, 0, Math.PI*2);
      ctx.fill();

      // spear indicator
      if(player.hasSpear){
        ctx.strokeStyle = "rgba(230,237,247,0.9)";
        ctx.lineWidth = 2;
        ctx.beginPath();
        ctx.moveTo(px+5, py-3);
        ctx.lineTo(px+14, py-10);
        ctx.stroke();
        ctx.lineWidth = 1;
      }

      // interaction highlight
      const r = nearbyResource();
      if(r){
        ctx.strokeStyle = "rgba(255,255,255,0.18)";
        ctx.strokeRect(r.x*TILE+2, r.y*TILE+2, TILE-4, TILE-4);
      }
    }

    // wolves
    for(const w of wolves){
      const px = w.x*TILE + TILE/2;
      const py = w.y*TILE + TILE/2;

      ctx.fillStyle = "rgba(249,115,22,0.95)";
      ctx.beginPath();
      ctx.arc(px, py, TILE*0.26, 0, Math.PI*2);
      ctx.fill();

      // hp mini bar
      const pct = clamp(w.hp / (30 + day*5), 0, 1);
      ctx.fillStyle = "rgba(0,0,0,0.35)";
      ctx.fillRect(px-12, py-18, 24, 4);
      ctx.fillStyle = "rgba(251,113,133,0.9)";
      ctx.fillRect(px-12, py-18, 24*pct, 4);
    }

    // overlay if dead
    if(player.hp <= 0){
      ctx.fillStyle = "rgba(0,0,0,0.55)";
      ctx.fillRect(0,0,W,H);
      ctx.fillStyle = "rgba(230,237,247,0.95)";
      ctx.font = "700 28px ui-sans-serif, system-ui";
      ctx.fillText("You Died", 20, 52);
      ctx.font = "500 14px ui-sans-serif, system-ui";
      ctx.fillText("Press R to restart. Tip: craft a spear early.", 20, 78);
    }

    // day progress bar (top)
    const pct = clamp(dayTick/45, 0, 1);
    ctx.fillStyle = "rgba(0,0,0,0.25)";
    ctx.fillRect(0,0,W,6);
    ctx.fillStyle = "rgba(255,255,255,0.18)";
    ctx.fillRect(0,0,W*pct,6);
  }

  function loop(t){
    const dt = Math.min(0.05, (t-last)/1000);
    last = t;
    if(player && player.hp > 0){
      update(dt);
    } else {
      // still draw when dead
      syncUI();
    }
    draw();
    requestAnimationFrame(loop);
  }

  // ====== Input ======
  window.addEventListener("keydown", (e) => {
    const k = e.key;
    if(["ArrowUp","ArrowDown","ArrowLeft","ArrowRight"," "].includes(k)) e.preventDefault();
    keys.add(k.length===1 ? k.toLowerCase() : k);
    if(k.toLowerCase()==="e") gather();
    if(k===" ") attack();
    if(k.toLowerCase()==="r"){
      rngSeed = Math.floor(Math.random() * 1e9);
      freshGame();
    }
  });
  window.addEventListener("keyup", (e) => {
    const k = e.key;
    keys.delete(k.length===1 ? k.toLowerCase() : k);
  });

  // buttons
  ui.gatherBtn.onclick = gather;
  ui.attackBtn.onclick = attack;
  ui.craftSpearBtn.onclick = craftSpear;
  ui.craftFireBtn.onclick = buildFire;

  // start
  ui.log.innerHTML = "";
  freshGame();
  requestAnimationFrame(loop);
})();
</script>
</body>
</html>
